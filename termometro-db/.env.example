# Plantilla de variables de entorno — ESTE archivo SÍ se sube al repo.
# Copiar a .env y rellenar con valores reales:
#
#   cp .env.example .env
#
# Dónde encontrar cada valor:
# Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

SUPABASE_PROJECT_REF=TU_PROJECT_REF

# NUNCA añadir aquí (ni en .env) claves secretas:
#   - contraseña de la base de datos
#   - service_role / secret key (sb_secret_...)
# Ambas se saltan RLS. Solo en servidor o en el keychain del CLI.
